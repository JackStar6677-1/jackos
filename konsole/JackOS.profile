[Appearance]
AntiAliasFonts=true
BoldIntense=true
ColorScheme=CyberpunkCapri
Font=JetBrainsMono Nerd Font,11,-1,5,50,0,0,0,0,0
UseFontLineCharacters=true

[Cursor Options]
CursorShape=1
UseCustomCursorColor=true
CustomCursorColor=212,0,26
CustomCursorTextColor=8,10,22

[General]
Command=/bin/bash
Environment=TERM=xterm-256color,COLORTERM=truecolor
Name=JackOS
Parent=FALLBACK/
StartInCurrentSessionDir=true

[Interaction Options]
AutoCopySelectedText=true
CopyTextAsHTML=false
OpenLinksByDirectClickEnabled=false
TrimLeadingSpacesInSelectedText=false
TrimTrailingSpacesInSelectedText=false
UnderlineFilesEnabled=true
UnderlineLinksEnabled=true

[Scrolling]
HistoryMode=2
ScrollBarPosition=2
ScrollFullPage=false

